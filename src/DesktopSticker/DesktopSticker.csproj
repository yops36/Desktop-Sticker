<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>..\..\App Icon\Blaues-W-mit-Bildsymbol_1_.ico</ApplicationIcon>
    <AssemblyName>DesktopSticker</AssemblyName>
    <RootNamespace>DesktopSticker</RootNamespace>
    <Version>1.1.0</Version>
    <Product>Desktop Sticker</Product>
    <Description>Lokales Windows-Werkzeug zum dauerhaften Platzieren eines Bild-Stickers auf dem Desktop-Hintergrund ohne Hintergrundprozess.</Description>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Deterministic>true</Deterministic>
    <PathMap>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)..\..\'))=.\</PathMap>
    <DebugType Condition="'$(Configuration)' == 'Release'">none</DebugType>
    <DebugSymbols Condition="'$(Configuration)' == 'Release'">false</DebugSymbols>
  </PropertyGroup>

  <ItemGroup>
    <!-- UI-Übersetzungen (Lokalisierung) – als Ressource eingebettet, damit auch der Single-File-Publish funktioniert -->
    <EmbeddedResource Include="Localization\Languages\*.json" LogicalName="DesktopSticker.Localization.Languages.%(Filename).json" />
  </ItemGroup>

</Project>
